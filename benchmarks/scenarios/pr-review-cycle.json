{
  "schema_version": 1,
  "id": "pr-review-cycle",
  "title": "Review a blocked PR and re-review its corrected immutable head",
  "fixture": "benchmarks/fixtures/reading-list",
  "pull_request": 17,
  "phases": [
    {
      "phase": "first-pr-review",
      "expected_head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected_blocker": "missing-title-validation",
      "turns": [
        {
          "kind": "first-review",
          "prompt": "benchmarks/prompts/pr-first-review.md"
        }
      ],
      "postconditions": [
        {
          "type": "command",
          "command": "node",
          "args": [
            "scripts/check-postcondition.mjs",
            "review-first"
          ],
          "expected_stdout": "first review postcondition ok\n"
        }
      ]
    },
    {
      "phase": "pr-re-review",
      "expected_head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "prior_review_tag": "<!-- plus-ultra:pr-review:inline -->",
      "expected_resolution": "missing-title-validation",
      "turns": [
        {
          "kind": "re-review",
          "prompt": "benchmarks/prompts/pr-re-review.md"
        }
      ],
      "postconditions": [
        {
          "type": "command",
          "command": "node",
          "args": [
            "scripts/check-postcondition.mjs",
            "review-rereview"
          ],
          "expected_stdout": "re-review postcondition ok\n"
        }
      ]
    }
  ]
}
